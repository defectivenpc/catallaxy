{
  "cd": {
    "bootstrap": "kubectl-ssa",
    "git": {
      "branch": "main",
      "credentialFromKubeSecret": {
        "context": "k3d-every-floe-core",
        "key": "password",
        "name": "forgejo-admin",
        "namespace": "forgejo",
        "username": "forgejo-admin"
      },
      "path": "manifests",
      "provider": "forgejo",
      "repo": "https://git.every-floe.test/forgejo-admin/lab.git"
    },
    "strategy": "argocd"
  },
  "clusterNames": [
    "core"
  ],
  "clusters": {
    "core": {
      "deploy": {
        "strategy": "kapp"
      },
      "edge": {
        "backend": "k3d-every-floe-core-server-0",
        "httpPort": 80,
        "httpsPort": 443,
        "mode": "proxy"
      },
      "exposedHosts": [
        {
          "bundle": "argocd/argocd",
          "host": "argocd.every-floe.test",
          "namespace": "argocd",
          "paths": [
            "/"
          ],
          "tier": "public"
        },
        {
          "bundle": "forgejo/forgejo",
          "host": "git.every-floe.test",
          "namespace": "forgejo",
          "paths": [
            "/"
          ],
          "tier": "public"
        },
        {
          "bundle": "grafana/grafana",
          "host": "grafana.every-floe.test",
          "namespace": "monitoring",
          "paths": [
            "/"
          ],
          "tier": "public"
        },
        {
          "bundle": "harbor/harbor",
          "host": "harbor.every-floe.test",
          "namespace": "harbor",
          "paths": [
            "/"
          ],
          "tier": "public"
        },
        {
          "bundle": "hello/hello",
          "host": "hello.every-floe.test",
          "namespace": "hello",
          "paths": [
            "/"
          ],
          "tier": "public"
        },
        {
          "bundle": "netbird/server",
          "host": "netbird.every-floe.test",
          "namespace": "netbird",
          "paths": [
            "/api",
            "/management.ManagementService/",
            "/signalexchange.SignalExchange/",
            "/relay",
            "/"
          ],
          "tier": "public"
        },
        {
          "bundle": "podinfo/podinfo",
          "host": "podinfo.every-floe.test",
          "namespace": "podinfo",
          "paths": [
            "/"
          ],
          "tier": "public"
        },
        {
          "bundle": "kanidm/server",
          "host": "idm.every-floe.test",
          "namespace": "default",
          "paths": [
            "/"
          ],
          "tier": "public"
        }
      ],
      "floes": {
        "argocd": {
          "enable": true
        },
        "cert-manager": {
          "enable": true
        },
        "cilium": {
          "enable": true
        },
        "cluster": {
          "enable": true
        },
        "cnpg": {
          "enable": true
        },
        "external-dns": {
          "enable": true
        },
        "external-secrets": {
          "enable": true
        },
        "forgejo": {
          "enable": true
        },
        "gateway": {
          "enable": true
        },
        "gateway-api": {
          "enable": true
        },
        "grafana": {
          "enable": true
        },
        "harbor": {
          "enable": true
        },
        "hello": {
          "enable": true
        },
        "kanidm": {
          "enable": true
        },
        "kaniop": {
          "enable": true
        },
        "lab-dns": {
          "enable": true
        },
        "loki": {
          "enable": true
        },
        "netbird": {
          "enable": true
        },
        "netbird-operator": {
          "enable": true
        },
        "openbao": {
          "enable": true
        },
        "openebs": {
          "enable": true
        },
        "otel-collector": {
          "enable": true
        },
        "podinfo": {
          "enable": true
        },
        "prometheus": {
          "enable": true
        },
        "provisioned": {
          "enable": true
        },
        "redis-operator": {
          "enable": true
        },
        "reloader": {
          "enable": true
        },
        "seaweedfs": {
          "enable": true
        },
        "secret-store": {
          "enable": true
        },
        "tempo": {
          "enable": true
        },
        "trust-manager": {
          "enable": true
        },
        "velero": {
          "enable": true
        },
        "zot": {
          "enable": true
        }
      },
      "host": {
        "colima": {
          "cpu": 4,
          "disk": 60,
          "enable": false,
          "memory": 8,
          "profile": "catallaxy"
        },
        "waitTimeout": "10m"
      },
      "infraStacks": [
        "core-provisioned-before-clusters"
      ],
      "kubeContext": "k3d-every-floe-core",
      "kubernetes": {
