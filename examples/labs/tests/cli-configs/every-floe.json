  "destroy": {},
  "dnsInfo": null,
  "infraPublications": [
    {
      "key": "provisioned/identity",
      "outputName": "identity_result",
      "stack": "core-provisioned-before-clusters",
      "store": "runtime"
    }
  ],
  "labName": "every-floe",
  "labNamespaces": {
    "core": [
      "argocd",
      "cert-manager",
      "cnpg-system",
      "external-dns",
      "external-secrets",
      "forgejo",
      "monitoring",
      "harbor",
      "hello",
      "kanidm",
      "loki",
      "netbird",
      "openbao",
      "openebs",
      "observability",
      "podinfo",
      "redis-operator",
      "reloader",
      "seaweedfs",
      "tempo",
      "velero",
      "zot"
    ]
  },
  "labOwnedRegistries": [],
  "network": {
    "dockerSubnet": "172.30.0.0/16",
    "name": "every-floe"
  },
  "opsToolPath": "/nix/store/HASH-every-floe-ops/bin/every-floe-ops",
  "registryPort": null,
  "registryUpstreams": [],
  "runtimeContexts": {
    "core": "k3d-every-floe-core"
  },
  "secrets": {
    "envFile": "examples/labs/tests/every-floe.env",
    "hostProjections": [],
    "managed": {
      "externaldns-tsig": {
        "keys": {
          "tsig-secret": {
            "generator": null,
            "length": null
          }
        },
        "kind": "value",
        "store": "knot"
      },
      "vault-credential": {
        "keys": {
          "token": {
            "generator": "hex",
            "length": 32
          }
        },
        "kind": "value",
        "store": "authored"
      }
    },
    "stores": {
      "authored": {
        "backend": "sops",
        "direction": "authored",
        "vault": {
          "path": "secret",
          "server": null,
          "version": "v2"
        },
        "writerCommand": null
      },
      "knot": {
        "backend": "env",
        "direction": "authored",
        "vault": {
          "path": "secret",
          "server": null,
          "version": "v2"
        },
        "writerCommand": null
      },
      "runtime": {
        "backend": "vault",
        "direction": "runtime",
        "vault": {
          "path": "secret",
          "server": "http://openbao.openbao.svc.cluster.local:8200",
          "version": "v2"
        },
        "writerCommand": null
      }
    }
  },
  "services": {},
  "verify": {
    "checks": {},
    "endpoints": {
      "acceptStatuses": [],
