      "name": "core",
      "network": {
        "podSubnet": "10.244.0.0/16",
        "serviceSubnet": "10.96.0.0/12"
      },
      "projections": {
        "externaldns-tsig": {
          "keys": {
            "tsig-secret": {
              "from": "tsig-secret",
              "jsonKey": null,
              "transform": "none"
            }
          },
          "namespace": "external-dns",
          "source": "externaldns-tsig"
        },
        "vault-token": {
          "keys": {
            "token": {
              "from": "token",
              "jsonKey": null,
              "transform": "none"
            }
          },
          "namespace": "external-secrets",
          "source": "vault-credential"
        }
      },
      "provider": "docker",
      "provisioner": "k3d",
      "provisionerConfig": {
        "k3d": {
          "autoDeployManifests": [
            {
              "name": "cilium",
              "path": "/nix/store/HASH-cilium-bootstrap.yaml"
            }
          ],
          "clusterName": "every-floe-core",
          "extraApiServerArgs": [],
          "extraVolumes": [],
          "image": "rancher/k3s:v1.31.4-k3s1",
          "network": "every-floe",
          "noFlannel": true,
          "noLocalStorage": false,
          "noServiceLB": false,
          "noTraefik": true,
          "ports": []
        }
      }
