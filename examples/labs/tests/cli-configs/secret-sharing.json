  "destroy": {},
  "dnsInfo": null,
  "infraPublications": [],
  "labName": "secret-sharing",
  "labNamespaces": {
    "core": [
      "cert-manager",
      "external-secrets"
    ],
    "obs": [
      "external-secrets"
    ]
  },
  "labOwnedRegistries": [],
  "network": {
    "dockerSubnet": "172.31.0.0/16",
    "name": "secret-sharing"
