        [
          {
            "hasReadyProbe": false,
            "name": "secret-publication/lab-ca-ca-secret",
            "resourceCount": 1
          }
        ]
      ],
      "name": "core",
      "network": {
        "podSubnet": "10.244.0.0/16",
