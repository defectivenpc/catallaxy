        "vault-token": {
          "keys": {
            "token": {
              "from": "token",
              "jsonKey": null,
              "transform": "none"
            }
          },
          "namespace": "external-secrets",
          "source": "vault-credential"
        }
      },
      "provider": "docker",
      "provisioner": "k3d",
      "provisionerConfig": {
        "k3d": {
          "autoDeployManifests": [],
          "clusterName": "secret-sharing-core",
          "extraApiServerArgs": [],
          "extraVolumes": [],
          "image": "rancher/k3s:v1.31.4-k3s1",
          "network": "secret-sharing",
          "noFlannel": false,
          "noLocalStorage": false,
          "noServiceLB": false,
          "noTraefik": true,
          "ports": []
