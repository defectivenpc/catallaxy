{
  "cd": {
    "bootstrap": "kubectl-ssa",
    "git": {},
    "strategy": "kapp"
  },
  "clusterNames": [
    "core",
    "obs"
  ],
  "clusters": {
    "core": {
      "deploy": {
        "strategy": "kapp"
      },
      "edge": {
        "backend": "k3d-secret-sharing-core-server-0",
        "httpPort": 80,
        "httpsPort": 443,
        "mode": "proxy"
      },
      "exposedHosts": [],
      "floes": {
        "cert-manager": {
          "enable": true
        },
        "cluster": {
          "enable": true
        },
        "external-secrets": {
          "enable": true
        },
        "store": {
          "enable": true
        }
      },
      "host": {
        "colima": {
          "cpu": 4,
          "disk": 60,
          "enable": false,
          "memory": 8,
          "profile": "catallaxy"
        },
        "waitTimeout": "10m"
      },
      "infraStacks": [],
      "kubeContext": "k3d-secret-sharing-core",
      "kubernetes": {
        "controlPlanes": 1,
        "distribution": "k3s",
        "version": "1.31",
        "workers": 0
      },
      "labName": "secret-sharing",
      "lifecycle": {},
      "manifestWaves": [
        [
          {
            "hasReadyProbe": false,
            "name": "external-secrets/crds",
            "resourceCount": 0
          },
          {
            "hasReadyProbe": false,
            "name": "namespaces",
            "resourceCount": 0
          }
        ],
        [
          {
            "hasReadyProbe": true,
