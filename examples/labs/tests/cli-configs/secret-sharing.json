      "provisionerConfig": {
        "k3d": {
          "autoDeployManifests": [],
          "clusterName": "secret-sharing-obs",
          "extraApiServerArgs": [],
          "extraVolumes": [],
          "image": "rancher/k3s:v1.31.4-k3s1",
          "network": "secret-sharing",
          "noFlannel": false,
          "noLocalStorage": false,
          "noServiceLB": false,
          "noTraefik": true,
          "ports": []
