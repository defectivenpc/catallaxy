  "services": {
    "dns": {
      "command": [
        "knotd"
      ],
      "container": "catallaxy-homelab.dns-dns",
      "description": "Knot DNS server (homelab.test)",
      "dnsContainers": [],
      "extraMounts": [],
      "image": "cznic/knot:latest",
      "networks": [
        "homelab.dns"
      ],
      "ports": [
        "5306:53/tcp",
        "5306:53/udp"
      ],
      "readyProbe": null,
      "volumes": {
        "/config/knot.conf": {
          "content": "server:\n  listen: 0.0.0.0@53\n\nlog:\n  - target: stdout\n    any: info\n\nkey:\n  - id: externaldns-key\n    algorithm: hmac-sha256\n    secret: kp4bgnFAVCmajGIqOW7rj0MNwRNZHBqMvYaLTwzPHgI=\n\nacl:\n  - id: update-acl\n    key: externaldns-key\n    action: [update, transfer]\n\nzone:\n  - domain: homelab.test.\n    storage: /storage\n    file: homelab.test.zone\n    acl: update-acl\n"
        },
        "/storage/homelab.test.zone": {
          "content": "$ORIGIN homelab.test.\n$TTL 300\n\n@   IN  SOA ns1.homelab.test. admin.homelab.test. (\n        2024010101  ; serial\n        3600        ; refresh\n        900         ; retry\n        604800      ; expire\n        300         ; minimum TTL\n    )\n\n@   IN  NS  ns1.homelab.test.\nns1 IN  A   127.0.0.1\ngit   IN  A   172.16.96.1\n    harbor   IN  A   172.16.96.1\n    idm   IN  A   172.16.96.1\n    grafana   IN  A   172.16.96.1\n"
        }
      }
    },
    "egress": {
      "command": [],
      "container": "catallaxy-homelab.dns-egress",
      "description": "Forward proxy inside the lab network (homelab.test)",
      "dnsContainers": [
        "catallaxy-homelab.dns-dns"
      ],
      "extraMounts": [],
      "image": "ghcr.io/querateam/docker-tinyproxy:latest",
      "networks": [
        "homelab.dns"
      ],
      "ports": [
        "127.0.0.1:3006:8888"
      ],
      "readyProbe": null,
      "volumes": {
        "/etc/tinyproxy/tinyproxy.conf": {
          "content": "Port 8888\nListen 0.0.0.0\nTimeout 600\nAllow 0.0.0.0/0\nConnectPort 443\nConnectPort 80\nLogLevel Info\n"
        }
      }
    },
    "proxy": {
      "command": [],
      "container": "catallaxy-homelab.dns-ingress",
      "description": "HAProxy lab ingress (homelab.test)",
      "dnsContainers": [],
      "extraMounts": [
        {
          "container": "/etc/haproxy/certs/lab.pem",
          "host": "{{STATE_DIR}}/proxy/lab.pem"
        }
      ],
      "image": "haproxy:3.1-alpine",
      "networks": [
        "homelab.dns"
      ],
      "ports": [
        "127.0.0.1:8006:80",
        "172.16.96.1:80:80",
        "127.0.0.1:8406:443",
        "172.16.96.1:443:443"
      ],
      "readyProbe": {
        "host": "127.0.0.1",
        "kind": "tcp",
        "port": 8006,
        "timeout": "60s"
      },
      "volumes": {
        "/usr/local/etc/haproxy/haproxy.cfg": {
          "content": "global\n    log stdout format raw local0 info\n\n# `init-addr none` with a resolver, rather than resolving at startup:\n# the proxy comes up before the cluster it points at exists, and\n# HAProxy refuses to start on a server name it cannot resolve.\nresolvers docker\n    nameserver dns1 127.0.0.11:53\n    resolve_retries 30\n    timeout resolve 1s\n    timeout retry 1s\n    hold valid 10s\n\ndefaults\n    timeout connect 5s\n    timeout client 1h\n    timeout server 1h\n    timeout tunnel 1h\n    log global\n\nfrontend ft_https\n    bind *:443 ssl crt /etc/haproxy/certs/lab.pem\n    mode http\n\n    use_backend bk_http_core if { req.hdr(host),field(1,:) -i git.homelab.test }\n    use_backend bk_http_core if { req.hdr(host),field(1,:) -i harbor.homelab.test }\n    use_backend bk_http_core if { req.hdr(host),field(1,:) -i idm.homelab.test }\n    use_backend bk_http_obs if { req.hdr(host),field(1,:) -i grafana.homelab.test }\n\nfrontend ft_http\n    bind *:80\n    mode http\n\n    # Redirect to the bare host, not `redirect scheme https`,\n    # which keeps whatever port the client used and would send it\n    # to HTTPS on the HTTP port. Dropping the port lands on 443,\n    # which is what the zone's wildcard reaches.\n    http-request redirect location https://%[req.hdr(host),field(1,:)]%[path] code 301\n\n\nbackend bk_http_core\n    mode http\n    server srv1 k3d-homelab-dns-core-server-0:443 ssl verify none init-addr none resolvers docker resolve-prefer ipv4\n\nbackend bk_http_obs\n    mode http\n    server srv1 k3d-homelab-dns-obs-server-0:443 ssl verify none init-addr none resolvers docker resolve-prefer ipv4\n"
        }
      }
    },
    "registry": {
      "command": [],
      "container": "catallaxy-homelab.dns-registry",
      "description": "Zot OCI registry (image cache)",
      "dnsContainers": [],
      "extraMounts": [],
      "image": "ghcr.io/project-zot/zot-linux-amd64:v2.1.17",
      "networks": [],
      "ports": [
        "5006:5000"
      ],
      "readyProbe": {
        "expectedStatus": 200,
        "host": "127.0.0.1",
        "kind": "http",
        "path": "/v2/",
        "port": 5006,
        "timeout": "60s"
      },
      "volumes": {
        "/etc/zot/config.json": {
          "content": "{\"distSpecVersion\":\"1.1.0\",\"extensions\":{\"sync\":{\"enable\":true,\"registries\":[{\"content\":[{\"prefix\":\"forgejo/**\"}],\"onDemand\":true,\"tlsVerify\":true,\"urls\":[\"https://codeberg.org\"]},{\"onDemand\":true,\"tlsVerify\":true,\"urls\":[\"https://registry.k8s.io\"]},{\"onDemand\":true,\"tlsVerify\":true,\"urls\":[\"https://ghcr.io\"]},{\"onDemand\":true,\"tlsVerify\":true,\"urls\":[\"https://quay.io\"]},{\"onDemand\":true,\"tlsVerify\":true,\"urls\":[\"https://registry-1.docker.io\"]},{\"onDemand\":true,\"tlsVerify\":true,\"urls\":[\"https://public.ecr.aws\"]},{\"onDemand\":true,\"tlsVerify\":true,\"urls\":[\"https://xpkg.upbound.io\"]},{\"onDemand\":true,\"tlsVerify\":true,\"urls\":[\"https://oci.external-secrets.io\"]}]}},\"http\":{\"address\":\"0.0.0.0\",\"compat\":[\"docker2s2\"],\"port\":\"5000\"},\"storage\":{\"dedupe\":true,\"rootDirectory\":\"/var/lib/zot\"}}"
        },
        "/var/lib/zot": {
          "persist": "data"
        }
      }
    }
  },
  "verify": {
    "checks": {},
    "endpoints": {
      "acceptStatuses": [],
      "enable": true
    }
  }
