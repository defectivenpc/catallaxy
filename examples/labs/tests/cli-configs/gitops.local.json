{
  "cd": {
    "bootstrap": "kubectl-ssa",
    "git": {
      "branch": "main",
      "credentialFromKubeSecret": {
        "context": "k3d-gitops-local-app",
        "key": "password",
        "name": "forgejo-admin",
        "namespace": "forgejo",
        "username": "forgejo-admin"
      },
      "path": "manifests",
      "provider": "forgejo",
      "repo": "https://git.gitops.test/forgejo-admin/lab.git"
    }
  },
  "clusterNames": [
    "app"
  ],
  "clusters": {
    "app": {
      "clusterHandle": {
        "context": "k3d-gitops-local-app",
        "instanceName": "gitops-local-app",
        "kubernetes": {
          "controlPlanes": 1,
          "distribution": "k3s",
          "version": "1.31",
          "workers": 0
        },
        "name": "app",
        "network": {
          "podSubnet": "10.244.0.0/16",
          "serviceSubnet": "10.96.0.0/12"
        }
      },
      "content": {
        "exposedHosts": [
          {
            "bundle": "argocd/argocd",
            "host": "argocd.gitops.test",
            "namespace": "argocd",
            "paths": [
              "/"
            ],
            "tier": "public"
          },
          {
            "bundle": "forgejo/forgejo",
            "host": "git.gitops.test",
            "namespace": "forgejo",
            "paths": [
              "/"
            ],
            "tier": "public"
          },
          {
            "bundle": "podinfo/podinfo",
            "host": "podinfo.gitops.test",
            "namespace": "podinfo",
            "paths": [
              "/"
            ],
            "tier": "public"
          }
        ],
        "namespaces": [
          "argocd",
          "forgejo",
          "cert-manager",
          "external-secrets",
          "podinfo"
        ],
        "projections": {},
        "tree": "/nix/store/HASH-floe-cluster-app",
        "waves": [
          [
            {
              "hasReadyProbe": false,
              "name": "namespaces",
              "resourceCount": 0
            },
            {
              "hasReadyProbe": false,
              "name": "platform/coredns-zone/coredns",
              "resourceCount": 1
            },
            {
              "hasReadyProbe": false,
              "name": "platform/external-secrets/crds",
              "resourceCount": 0
            },
            {
              "hasReadyProbe": false,
              "name": "platform/gateway-api/crds",
              "resourceCount": 0
            }
          ],
          [
            {
              "hasReadyProbe": true,
              "name": "platform/cert-manager/cert-manager",
              "resourceCount": 0
            },
            {
              "hasReadyProbe": true,
              "name": "platform/external-secrets/external-secrets",
              "resourceCount": 0
            }
          ],
          [
            {
              "hasReadyProbe": true,
              "name": "platform/cert-manager/issuers",
              "resourceCount": 1
            }
          ],
          [
            {
              "hasReadyProbe": true,
              "name": "platform/gateway/controller",
              "resourceCount": 0
            },
            {
              "hasReadyProbe": true,
              "name": "platform/trust-manager/trust-manager",
              "resourceCount": 0
            }
          ],
          [
            {
              "hasReadyProbe": true,
              "name": "platform/gateway/gateway",
              "resourceCount": 2
            },
            {
              "hasReadyProbe": true,
              "name": "platform/trust-manager/bundles",
              "resourceCount": 2
            }
          ],
          [
            {
              "hasReadyProbe": true,
              "name": "forgejo/forgejo",
              "resourceCount": 3
            },
            {
              "hasReadyProbe": true,
              "name": "podinfo/podinfo",
              "resourceCount": 3
            }
          ],
          [
            {
              "hasReadyProbe": true,
              "name": "argocd/argocd",
              "resourceCount": 6
            },
            {
              "hasReadyProbe": false,
              "name": "forgejo/bootstrap",
              "resourceCount": 2
            }
          ]
        ]
      },
      "delivery": {
        "strategy": "argocd",
        "waitTimeout": "10m"
      },
      "provisioning": {
        "config": {
          "k3d": {
            "autoDeployManifests": [],
            "clusterName": "gitops-local-app",
            "extraApiServerArgs": [],
            "extraK3sArgs": [],
            "extraVolumes": [],
            "image": "rancher/k3s:v1.31.4-k3s1",
            "network": "gitops.local",
            "noFlannel": false,
            "noLocalStorage": false,
            "noServiceLB": false,
            "noTraefik": true,
            "nodeConfigFrom": "registry",
            "ports": []
          }
        },
        "hooks": [],
        "wait": "10m"
      }
    }
  },
  "destroy": {},
  "dnsInfo": {
    "host": "127.0.0.1",
    "port": 5552,
    "tsigKeyname": "externaldns-key",
    "tsigSecret": "kp4bgnFAVCmajGIqOW7rj0MNwRNZHBqMvYaLTwzPHgI=",
    "tsigSecretAlg": "hmac-sha256",
    "zone": "gitops.test"
  },
  "infraPublications": [],
  "labName": "gitops.local",
  "labOwnedRegistries": [],
  "network": {
    "dockerSubnet": "172.31.192.0/20",
    "name": "gitops.local"
  },
  "opsToolPath": "/nix/store/HASH-gitops.local-ops/bin/gitops.local-ops",
  "registryPort": 5252,
  "registryUpstreams": [
    "codeberg.org",
    "registry.k8s.io",
    "ghcr.io",
    "quay.io",
    "docker.io",
    "public.ecr.aws",
    "xpkg.upbound.io",
    "oci.external-secrets.io"
  ],
  "routedHosts": {
    "app": [
      "argocd.gitops.test",
      "git.gitops.test",
      "podinfo.gitops.test"
    ]
  },
  "secrets": {
    "envFile": null,
    "hostProjections": [],
    "managed": {},
    "stores": {}
  },
  "services": {
    "dns": {
      "command": [
        "knotd"
      ],
      "container": "catallaxy-gitops.local-dns",
      "description": "Knot DNS server (gitops.test)",
      "dnsContainers": [],
      "extraMounts": [],
      "image": "cznic/knot:latest",
      "networks": [
        "gitops.local"
      ],
      "ports": [
        "5552:53/tcp",
        "5552:53/udp"
      ],
      "readyProbe": null,
      "volumes": {
        "/config/knot.conf": {
          "content": "server:\n  listen: 0.0.0.0@53\n\nlog:\n  - target: stdout\n    any: info\n\nkey:\n  - id: externaldns-key\n    algorithm: hmac-sha256\n    secret: kp4bgnFAVCmajGIqOW7rj0MNwRNZHBqMvYaLTwzPHgI=\n\nacl:\n  - id: update-acl\n    key: externaldns-key\n    action: [update, transfer]\n\nzone:\n  - domain: gitops.test.\n    storage: /storage\n    file: gitops.test.zone\n    acl: update-acl\n"
        },
        "/storage/gitops.test.zone": {
          "content": "$ORIGIN gitops.test.\n$TTL 300\n\n@   IN  SOA ns1.gitops.test. admin.gitops.test. (\n        2024010101  ; serial\n        3600        ; refresh\n        900         ; retry\n        604800      ; expire\n        300         ; minimum TTL\n    )\n\n@   IN  NS  ns1.gitops.test.\nns1 IN  A   127.0.0.1\nargocd   IN  A   172.31.192.1\n    git   IN  A   172.31.192.1\n    podinfo   IN  A   172.31.192.1\n"
        }
      }
    },
    "egress": {
      "command": [],
      "container": "catallaxy-gitops.local-egress",
      "description": "Forward proxy inside the lab network (gitops.test)",
      "dnsContainers": [
        "catallaxy-gitops.local-dns"
      ],
      "extraMounts": [],
      "image": "ghcr.io/querateam/docker-tinyproxy:latest",
      "networks": [
        "gitops.local"
      ],
      "ports": [
        "127.0.0.1:3252:8888"
      ],
      "readyProbe": null,
      "volumes": {
        "/etc/tinyproxy/tinyproxy.conf": {
          "content": "Port 8888\nListen 0.0.0.0\nTimeout 600\nAllow 0.0.0.0/0\nConnectPort 443\nConnectPort 80\nLogLevel Info\n"
        }
      }
    },
    "proxy": {
      "command": [],
      "container": "catallaxy-gitops.local-ingress",
      "description": "HAProxy lab ingress (gitops.test)",
      "dnsContainers": [],
      "extraMounts": [
        {
          "container": "/etc/haproxy/certs/lab.pem",
          "host": "{{STATE_DIR}}/proxy/lab.pem"
        }
      ],
      "image": "haproxy:3.1-alpine",
      "networks": [
        "gitops.local"
      ],
      "ports": [
        "127.0.0.1:8252:80",
        "172.31.192.1:80:80",
        "127.0.0.1:8652:443",
        "172.31.192.1:443:443"
      ],
      "readyProbe": {
        "host": "127.0.0.1",
        "kind": "tcp",
        "port": 8252,
        "timeout": "60s"
      },
      "volumes": {
        "/usr/local/etc/haproxy/haproxy.cfg": {
          "content": "global\n    log stdout format raw local0 info\n\n# `init-addr none` with a resolver, rather than resolving at startup:\n# the proxy comes up before the cluster it points at exists, and\n# HAProxy refuses to start on a server name it cannot resolve.\nresolvers docker\n    nameserver dns1 127.0.0.11:53\n    resolve_retries 30\n    timeout resolve 1s\n    timeout retry 1s\n    hold valid 10s\n\ndefaults\n    timeout connect 5s\n    timeout client 1h\n    timeout server 1h\n    timeout tunnel 1h\n    log global\n\nfrontend ft_https\n    bind *:443 ssl crt /etc/haproxy/certs/lab.pem\n    mode http\n\n    use_backend bk_http_app if { req.hdr(host),field(1,:) -i argocd.gitops.test }\n    use_backend bk_http_app if { req.hdr(host),field(1,:) -i git.gitops.test }\n    use_backend bk_http_app if { req.hdr(host),field(1,:) -i podinfo.gitops.test }\n\nfrontend ft_http\n    bind *:80\n    mode http\n\n    # Redirect to the bare host, not `redirect scheme https`,\n    # which keeps whatever port the client used and would send it\n    # to HTTPS on the HTTP port. Dropping the port lands on 443,\n    # which is what the zone's wildcard reaches.\n    http-request redirect location https://%[req.hdr(host),field(1,:)]%[path] code 301\n\n\nbackend bk_http_app\n    mode http\n    server srv1 k3d-gitops-local-app-server-0:443 ssl verify none init-addr none resolvers docker resolve-prefer ipv4\n"
        }
      }
    },
    "registry": {
      "command": [],
      "container": "catallaxy-gitops.local-registry",
      "description": "Zot OCI registry (image cache)",
      "dnsContainers": [],
      "extraMounts": [],
      "image": "ghcr.io/project-zot/zot-linux-amd64:v2.1.17",
      "networks": [],
      "ports": [
        "5252:5000"
      ],
      "readyProbe": {
        "expectedStatus": 200,
        "host": "127.0.0.1",
        "kind": "http",
        "path": "/v2/",
        "port": 5252,
        "timeout": "60s"
      },
      "volumes": {
        "/etc/zot/config.json": {
          "content": "{\"distSpecVersion\":\"1.1.0\",\"extensions\":{\"sync\":{\"enable\":true,\"registries\":[{\"content\":[{\"prefix\":\"forgejo/**\"}],\"onDemand\":true,\"tlsVerify\":true,\"urls\":[\"https://codeberg.org\"]},{\"onDemand\":true,\"tlsVerify\":true,\"urls\":[\"https://registry.k8s.io\"]},{\"onDemand\":true,\"tlsVerify\":true,\"urls\":[\"https://ghcr.io\"]},{\"onDemand\":true,\"tlsVerify\":true,\"urls\":[\"https://quay.io\"]},{\"onDemand\":true,\"tlsVerify\":true,\"urls\":[\"https://registry-1.docker.io\"]},{\"onDemand\":true,\"tlsVerify\":true,\"urls\":[\"https://public.ecr.aws\"]},{\"onDemand\":true,\"tlsVerify\":true,\"urls\":[\"https://xpkg.upbound.io\"]},{\"onDemand\":true,\"tlsVerify\":true,\"urls\":[\"https://oci.external-secrets.io\"]}]}},\"http\":{\"address\":\"0.0.0.0\",\"compat\":[\"docker2s2\"],\"port\":\"5000\"},\"storage\":{\"dedupe\":true,\"rootDirectory\":\"/var/lib/zot\"}}"
        },
        "/var/lib/zot": {
          "persist": "data"
        }
      }
    }
  },
  "verify": {
    "checks": {},
    "endpoints": {
      "acceptStatuses": [],
      "enable": true
    }
  }
}
