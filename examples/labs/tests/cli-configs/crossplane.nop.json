      "dnsContainers": [],
      "extraMounts": [],
      "image": "ghcr.io/project-zot/zot-linux-amd64:v2.1.17",
      "networks": [],
      "ports": [
        "5160:5000"
      ],
      "readyProbe": {
        "expectedStatus": 200,
        "host": "127.0.0.1",
        "kind": "http",
        "path": "/v2/",
        "port": 5160,
        "timeout": "60s"
