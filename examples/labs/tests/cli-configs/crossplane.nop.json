            "extraVolumes": [],
            "image": "rancher/k3s:v1.31.4-k3s1",
            "network": "crossplane.nop",
            "noFlannel": false,
            "noLocalStorage": false,
            "noServiceLB": false,
            "noTraefik": true,
            "nodeConfigFrom": "registry",
            "ports": []
