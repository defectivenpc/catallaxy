          [
            {
              "hasReadyProbe": true,
              "name": "provider/provider",
              "resourceCount": 1
            }
          ],
          [
            {
              "hasReadyProbe": true,
              "name": "workload/nop",
              "resourceCount": 1
            }
          ]
        ]
      },
      "delivery": {
        "strategy": "kapp",
        "waitTimeout": "10m"
      },
      "provisioning": {
        "config": {
          "k3d": {
            "autoDeployManifests": [],
