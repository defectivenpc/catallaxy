        },
        "hooks": [],
        "wait": "10m"
      }
    }
  },
  "destroy": {},
  "dnsInfo": null,
  "infraPublications": [],
  "labName": "crossplane.nop",
  "labOwnedRegistries": [],
  "network": {
    "dockerSubnet": "172.26.0.0/20",
    "name": "crossplane.nop"
  },
  "opsToolPath": null,
  "registryPort": 5160,
  "registryUpstreams": [
    "codeberg.org",
    "registry.k8s.io",
    "ghcr.io",
    "quay.io",
    "docker.io",
    "public.ecr.aws",
    "xpkg.upbound.io",
    "oci.external-secrets.io"
  ],
  "routedHosts": {},
