{
  "cd": {
    "bootstrap": "kubectl-ssa",
    "git": {}
  },
  "clusterNames": [
    "home",
    "workload"
  ],
  "clusters": {
    "home": {
      "claim": {
        "context": "k3d-cloud-home",
        "instanceName": "cloud-home",
        "kubernetes": {
          "controlPlanes": 1,
          "distribution": "k3s",
          "version": "1.31",
          "workers": 0
        },
        "name": "home",
        "network": {
          "podSubnet": "10.244.0.0/16",
          "serviceSubnet": "10.96.0.0/12"
        }
      },
      "content": {
        "exposedHosts": [],
        "namespaces": [
          "cert-manager"
        ],
        "projections": {},
        "tree": "/nix/store/HASH-floe-cluster-home",
        "waves": [
          [
            {
              "hasReadyProbe": false,
              "name": "gateway-api/crds",
              "resourceCount": 0
            },
            {
              "hasReadyProbe": false,
              "name": "namespaces",
              "resourceCount": 0
            }
          ],
          [
            {
              "hasReadyProbe": true,
              "name": "cert-manager/cert-manager",
              "resourceCount": 0
            }
          ],
          [
            {
              "hasReadyProbe": true,
              "name": "cert-manager/issuers",
              "resourceCount": 1
            }
          ],
          [
            {
              "hasReadyProbe": true,
              "name": "gateway/controller",
              "resourceCount": 0
            }
          ],
          [
            {
              "hasReadyProbe": true,
              "name": "gateway/gateway",
              "resourceCount": 1
            }
          ]
        ]
      },
      "delivery": {
        "strategy": "kapp",
        "waitTimeout": "10m"
      },
      "provisioning": {
        "config": {
          "k3d": {
            "autoDeployManifests": [],
            "clusterName": "cloud-home",
            "extraApiServerArgs": [],
            "extraK3sArgs": [],
            "extraVolumes": [],
            "image": "rancher/k3s:v1.31.4-k3s1",
            "network": "cloud",
            "noFlannel": false,
            "noLocalStorage": false,
            "noServiceLB": false,
            "noTraefik": true,
            "nodeConfigFrom": null,
            "ports": []
          }
        },
        "hooks": [],
        "wait": "10m"
      }
    },
    "workload": {
      "claim": {
        "context": "cata-cloud-workload",
        "instanceName": "workload",
        "kubernetes": {
          "controlPlanes": 0,
          "distribution": "kubernetes",
          "version": "1.31",
          "workers": 0
        },
        "name": "workload",
        "network": {
          "podSubnet": "10.244.0.0/16",
          "serviceSubnet": "10.245.0.0/16"
        }
      },
      "content": {
        "exposedHosts": [
          {
            "bundle": "podinfo/podinfo",
            "host": "podinfo.cloud.test",
            "namespace": "podinfo",
            "paths": [
              "/"
            ],
            "tier": "public"
          }
        ],
        "namespaces": [
          "cert-manager",
          "podinfo"
        ],
        "projections": {},
        "tree": "/nix/store/HASH-floe-cluster-workload",
        "waves": [
          [
            {
              "hasReadyProbe": false,
              "name": "gateway-api/crds",
              "resourceCount": 0
            },
            {
              "hasReadyProbe": false,
              "name": "namespaces",
              "resourceCount": 0
            }
          ],
          [
            {
              "hasReadyProbe": true,
              "name": "cert-manager/cert-manager",
              "resourceCount": 0
            }
          ],
          [
            {
              "hasReadyProbe": true,
              "name": "cert-manager/issuers",
              "resourceCount": 1
            }
          ],
          [
            {
              "hasReadyProbe": true,
              "name": "gateway/controller",
              "resourceCount": 0
            }
          ],
          [
            {
              "hasReadyProbe": true,
              "name": "gateway/gateway",
              "resourceCount": 1
            }
          ],
          [
            {
              "hasReadyProbe": true,
              "name": "podinfo/podinfo",
              "resourceCount": 3
            }
          ]
        ]
      },
      "delivery": {
        "strategy": "kapp",
        "waitTimeout": "10m"
      },
      "provisioning": {
        "config": {
          "external": {
            "madeBy": "opentofu, from the 'doks' floe on 'home'",
            "provisionedBy": null
          }
        },
        "hooks": [],
        "wait": "10m"
      }
    }
  },
  "destroy": {},
  "dnsInfo": null,
  "infraPublications": [
    {
      "key": "clusters/workload/kubeconfig",
      "outputName": "cluster_kube_config",
      "stack": "home-doks-before-clusters",
      "store": "cloud"
    }
  ],
  "labName": "cloud",
  "labOwnedRegistries": [],
  "network": {
    "dockerSubnet": "172.17.0.0/20",
    "name": "cloud"
  },
  "opsToolPath": "/nix/store/HASH-cloud-ops/bin/cloud-ops",
  "registryPort": null,
  "registryUpstreams": [],
  "routedHosts": {},
  "secrets": {
    "envFile": null,
    "hostProjections": [],
    "managed": {},
    "stores": {
      "cloud": {
        "backend": "env",
        "direction": "authored",
        "removerCommand": null,
        "vault": {
          "path": "secret",
          "server": null,
          "version": "v2"
        },
        "writerCommand": null
      }
    }
  },
  "services": {
    "egress": {
      "command": [],
      "container": "catallaxy-cloud-egress",
      "description": "Forward proxy inside the lab network (cloud.test)",
      "dnsContainers": [],
      "extraMounts": [],
      "image": "ghcr.io/querateam/docker-tinyproxy:latest",
      "networks": [
        "cloud"
      ],
      "ports": [
        "127.0.0.1:3016:8888"
      ],
      "readyProbe": null,
      "volumes": {
        "/etc/tinyproxy/tinyproxy.conf": {
          "content": "Port 8888\nListen 0.0.0.0\nTimeout 600\nAllow 0.0.0.0/0\nConnectPort 443\nConnectPort 80\nLogLevel Info\n"
        }
      }
    },
    "proxy": {
      "command": [],
      "container": "catallaxy-cloud-ingress",
      "description": "HAProxy lab ingress (cloud.test)",
      "dnsContainers": [],
      "extraMounts": [
        {
          "container": "/etc/haproxy/certs/lab.pem",
          "host": "{{STATE_DIR}}/proxy/lab.pem"
        }
      ],
      "image": "haproxy:3.1-alpine",
      "networks": [
        "cloud"
      ],
      "ports": [
        "127.0.0.1:8016:80",
        "172.17.0.1:80:80",
        "127.0.0.1:8416:443",
        "172.17.0.1:443:443"
      ],
      "readyProbe": {
        "host": "127.0.0.1",
        "kind": "tcp",
        "port": 8016,
        "timeout": "60s"
      },
      "volumes": {
        "/usr/local/etc/haproxy/haproxy.cfg": {
          "content": "global\n    log stdout format raw local0 info\n\n# `init-addr none` with a resolver, rather than resolving at startup:\n# the proxy comes up before the cluster it points at exists, and\n# HAProxy refuses to start on a server name it cannot resolve.\nresolvers docker\n    nameserver dns1 127.0.0.11:53\n    resolve_retries 30\n    timeout resolve 1s\n    timeout retry 1s\n    hold valid 10s\n\ndefaults\n    timeout connect 5s\n    timeout client 1h\n    timeout server 1h\n    timeout tunnel 1h\n    log global\n\nfrontend ft_https\n    bind *:443 ssl crt /etc/haproxy/certs/lab.pem\n    mode http\n\n\n\nfrontend ft_http\n    bind *:80\n    mode http\n\n    # Redirect to the bare host, not `redirect scheme https`,\n    # which keeps whatever port the client used and would send it\n    # to HTTPS on the HTTP port. Dropping the port lands on 443,\n    # which is what the zone's wildcard reaches.\n    http-request redirect location https://%[req.hdr(host),field(1,:)]%[path] code 301\n\n\n\n"
        }
      }
    }
  },
  "verify": {
    "checks": {},
    "endpoints": {
      "acceptStatuses": [],
      "enable": true
    }
  }
}
