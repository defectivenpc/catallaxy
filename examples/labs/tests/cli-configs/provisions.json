{
  "cd": {
    "bootstrap": "kubectl-ssa",
    "git": {}
  },
  "clusterNames": [
    "mgmt",
    "workload"
  ],
  "clusters": {
    "mgmt": {
      "claim": {
        "context": "k3d-provisions-mgmt",
        "instanceName": "provisions-mgmt",
        "kubernetes": {
          "controlPlanes": 1,
          "distribution": "k3s",
          "version": "1.31",
          "workers": 0
        },
        "name": "mgmt",
        "network": {
          "podSubnet": "10.244.0.0/16",
          "serviceSubnet": "10.96.0.0/12"
        }
      },
      "content": {
        "exposedHosts": [],
        "namespaces": [
          "cert-manager"
        ],
        "projections": {},
        "tree": "/nix/store/HASH-floe-cluster-mgmt",
        "waves": [
          [
            {
              "hasReadyProbe": false,
              "name": "gateway-api/crds",
              "resourceCount": 0
            },
            {
              "hasReadyProbe": false,
              "name": "namespaces",
              "resourceCount": 0
            }
          ],
          [
            {
              "hasReadyProbe": true,
              "name": "cert-manager/cert-manager",
              "resourceCount": 0
            }
          ],
          [
            {
              "hasReadyProbe": true,
              "name": "cert-manager/issuers",
              "resourceCount": 3
            }
          ],
          [
            {
              "hasReadyProbe": true,
              "name": "gateway/controller",
              "resourceCount": 0
            }
          ],
          [
            {
              "hasReadyProbe": true,
              "name": "gateway/gateway",
              "resourceCount": 1
            }
          ]
        ]
      },
      "delivery": {
        "strategy": "kapp",
        "waitTimeout": "10m"
      },
      "provisioning": {
        "config": {
          "k3d": {
            "autoDeployManifests": [],
            "clusterName": "provisions-mgmt",
            "extraApiServerArgs": [],
            "extraK3sArgs": [],
            "extraVolumes": [],
            "image": "rancher/k3s:v1.31.4-k3s1",
            "network": "provisions",
            "noFlannel": false,
            "noLocalStorage": false,
            "noServiceLB": false,
            "noTraefik": true,
            "nodeConfigFrom": null,
            "ports": []
          }
        },
        "hooks": [],
        "wait": "10m"
      }
    },
    "workload": {
      "claim": {
        "context": "cata-provisions-workload",
        "instanceName": "workload",
        "kubernetes": {
          "controlPlanes": 0,
          "distribution": "kubernetes",
          "version": "1.31",
          "workers": 0
        },
        "name": "workload",
        "network": {
          "podSubnet": "10.246.0.0/16",
          "serviceSubnet": "10.113.0.0/16"
        }
      },
      "content": {
        "exposedHosts": [
          {
            "bundle": "podinfo/podinfo",
            "host": "podinfo.provisions.test",
            "namespace": "podinfo",
            "paths": [
              "/"
            ],
            "tier": "public"
          }
        ],
        "namespaces": [
          "cert-manager",
          "podinfo"
        ],
        "projections": {},
        "tree": "/nix/store/HASH-floe-cluster-workload",
        "waves": [
          [
            {
              "hasReadyProbe": false,
              "name": "gateway-api/crds",
              "resourceCount": 0
            },
            {
              "hasReadyProbe": false,
              "name": "namespaces",
              "resourceCount": 0
            }
          ],
          [
            {
              "hasReadyProbe": true,
              "name": "cert-manager/cert-manager",
              "resourceCount": 0
            }
          ],
          [
            {
              "hasReadyProbe": true,
              "name": "cert-manager/issuers",
              "resourceCount": 3
            }
          ],
          [
            {
              "hasReadyProbe": true,
              "name": "gateway/controller",
              "resourceCount": 0
            }
          ],
          [
            {
              "hasReadyProbe": true,
              "name": "gateway/gateway",
              "resourceCount": 1
            }
          ],
          [
            {
              "hasReadyProbe": true,
              "name": "podinfo/podinfo",
              "resourceCount": 3
            }
          ]
        ]
      },
      "delivery": {
        "strategy": "kapp",
        "waitTimeout": "10m"
      },
      "provisioning": {
        "config": {
          "external": {
            "madeBy": "clusters.kubernetes.digitalocean.crossplane.io/workload",
            "provisionedBy": {
              "resourceKind": "clusters.kubernetes.digitalocean.crossplane.io",
              "resourceName": "workload"
            }
          }
        },
        "hooks": [],
        "wait": "10m"
      }
    }
  },
  "destroy": {},
  "dnsInfo": null,
  "infraPublications": [],
  "labName": "provisions",
  "labOwnedRegistries": [],
  "network": {
    "dockerSubnet": "172.22.224.0/20",
    "name": "provisions"
  },
  "opsToolPath": "/nix/store/HASH-provisions-ops/bin/provisions-ops",
  "registryPort": null,
  "registryUpstreams": [],
  "routedHosts": {},
  "secrets": {
    "envFile": null,
    "hostProjections": [],
    "managed": {},
    "stores": {}
  },
  "services": {},
  "verify": {
    "checks": {},
    "endpoints": {
      "acceptStatuses": [],
      "enable": true
    }
  }
}
