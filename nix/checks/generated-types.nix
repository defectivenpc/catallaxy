# The committed Kubernetes and CRD types match what their sources produce.
#
# Same shape as `option-docs` and the floe-interface checks: the tree is
# generated, so the only way it can be wrong is by being stale. Stale here is
# worse than elsewhere, because these types are what a rendered resource is
# checked against — a chart version bumped in `lib/charts.nix` without a
# refresh leaves every floe validated against the CRD of the release before.
#
# This check is also what says the tree is generated. The emitter writes no
# banner, because the repo bans `#` comments in Nix.
{
  lib,
  pkgs,
  generatedTypes,
  floeCrds,
}:

let
  # The committed tree, in the shape the generator writes: the Kubernetes API
  # under `k8s/`, and each floe's groups under its own name. Assembled rather
  # than diffed in place, because the two halves live in different trees now
  # and one `diff -ru` over a matching shape says more than two over halves.
  committed = pkgs.runCommand "committed-types" { } (
    ''
      mkdir -p $out
      cp -r ${../../lib/kubernetes/generated/k8s} $out/k8s
    ''
    + lib.concatStrings (
      lib.mapAttrsToList (floe: _: ''
        mkdir -p $out/${floe}
        cp -r ${../../floes}/components/${floe}/crds $out/${floe}/crds
      '') floeCrds.sources
    )
  );
  # A `crds/` with no `crds.nix` beside it. `floes/crds.nix` only walks floes
  # that name a source, so such a directory is loaded by nothing and generated
  # from nothing — it would sit there looking like types while every custom
  # resource in its group resolved to no schema.
  orphaned = lib.attrNames (
    lib.filterAttrs (
      floe: _:
      builtins.pathExists (../../floes/components + "/${floe}/crds")
      && !(builtins.pathExists (../../floes/components + "/${floe}/crds.nix"))
    ) (builtins.readDir ../../floes/components)
  );
in
{
  generated-types = pkgs.runCommand "generated-types-check" { } ''
    ${lib.optionalString (orphaned != [ ]) ''
      echo "a floe carries generated CRD types and names no source:" >&2
      ${lib.concatMapStringsSep "\n" (f: ''echo "  floes/components/${f}" >&2'') orphaned}
      cat >&2 <<'EOF'

      `floes/crds.nix` finds a floe's types by its `crds.nix`, so a `crds/`
      without one is loaded by nothing and regenerated by nothing. Every
      custom resource in those groups resolves to no schema and is checked for
      nothing.

      Add the `crds.nix` naming the artifact, or delete the directory.
      EOF
      exit 1
    ''}

    if ! diff -ru ${committed} ${generatedTypes} > $TMPDIR/diff; then
      cat $TMPDIR/diff >&2
      echo "" >&2
      echo "The generated Kubernetes types are stale." >&2
      echo "" >&2
      echo "They are generated from the same pinned artifacts the floes" >&2
      echo "install — each floe's own \`crds.nix\` names one — so this diff" >&2
      echo "means a source" >&2
      echo "moved and the types still describe the old one. A resource is" >&2
      echo "checked against these, so the gap is checks passing against a" >&2
      echo "CRD that is no longer what gets applied." >&2
      echo "" >&2
      echo "Refresh it and read the diff:" >&2
      echo "  nix build .#generatedTypes   # k8s/ and <floe>/crds/, to copy into place" >&2
      exit 1
    fi
    touch $out
  '';
}
