/*
  What a central chart registry was enforcing by accident, now that there
  isn't one.

  Three facts about the pins across a floe set:

  1. **No two floes pin the same upstream.** Two floes whose `upstream.nix`
     yields the same chart derivation are installing the same thing twice. The
     registry had `local-path-provisioner` and `openebs` as byte-identical
     entries — same repo, chart, version and hash — and nothing noticed,
     because a table of names cannot tell you that two of them are one.
  2. **No API group is claimed by two floes.** `lib/floe-crds.nix` merges
     `group -> type file` across the set, and a group in two floes would be
     two files claiming one key. `cata-build generate` refused this when it
     saw every source at once; a floe that owns its own generation does not
     give it that view.
  3. **No `upstream.nix` belongs to nothing.** A pin in a directory that is
     not a floe in the set is collected by nobody and regenerated by nobody —
     the leftover of a deleted floe, looking exactly like a live pin.

  The counterpart to this is in `generated-types`, which refuses the other
  direction: a `crds/` directory with no pin yielding CRDs.
*/
{
  lib,
  pkgs,
  floeSet,
  upstream,
  floeCrds,

  # Two floes that pin one upstream on purpose, and why. Empty, and a new
  # entry should have to argue for itself: the duplicate this check was
  # written for was a mistake nobody had made deliberately.
  sharedPins ? { },
}:

let
  dirOfFloe = path: if builtins.pathExists (path + "/default.nix") then path else dirOf path;

  pinned = lib.filterAttrs (_: dir: builtins.pathExists (dir + "/upstream.nix")) (
    lib.mapAttrs (_: dirOfFloe) floeSet
  );

  pinOf = dir: import (dir + "/upstream.nix") { inherit upstream; };

  # floe -> the chart it pins, by store path. A floe with no chart — a pin
  # that is only a release artifact — has nothing to collide.
  #
  # The context is discarded because the path is wanted as *data*: two floes
  # pinning one upstream is a fact about equal paths, and a check that
  # depended on the charts would build 25 of them to compare their names.
  charts = lib.mapAttrs (_: dir: builtins.unsafeDiscardStringContext "${(pinOf dir).chart}") (
    lib.filterAttrs (_: dir: pinOf dir ? chart) pinned
  );

  duplicates = lib.filterAttrs (_: floes: lib.length floes > 1) (
    lib.foldl' (
      acc: floe: acc // { ${charts.${floe}} = (acc.${charts.${floe}} or [ ]) ++ [ floe ]; }
    ) { } (lib.attrNames charts)
  );

  claimed = lib.attrNames duplicates;
  allowed = lib.attrNames sharedPins;

  unexplained = lib.subtractLists allowed claimed;
  resolved = lib.subtractLists claimed allowed;

  # Every group, with the floe that declared it, so a collision names both
  # sides. `floeCrds.groups` has already merged them and cannot.
  groupsOf =
    dir:
    let
      crdDir = dir + "/crds";
    in
    lib.optionals (builtins.pathExists crdDir) (
      map (lib.removeSuffix ".nix") (
        lib.attrNames (lib.filterAttrs (_: k: k == "regular") (builtins.readDir crdDir))
      )
    );

  byGroup = lib.foldl' (
    acc: floe:
    lib.foldl' (inner: g: inner // { ${g} = (inner.${g} or [ ]) ++ [ floe ]; }) acc (
      groupsOf pinned.${floe}
    )
  ) { } (lib.attrNames pinned);

  contested = lib.filterAttrs (_: floes: lib.length floes > 1) byGroup;

  # Pins on disk, against pins the set reaches.
  onDisk = lib.attrNames (
    lib.filterAttrs (
      name: kind:
      kind == "directory" && builtins.pathExists (../../floes/components + "/${name}/upstream.nix")
    ) (builtins.readDir ../../floes/components)
  );

  reached = map (dir: baseNameOf (toString dir)) (lib.attrValues pinned);
  orphans = lib.subtractLists reached onDisk;

  lines = lib.concatStringsSep "\n";
  inline = lib.concatStringsSep ", ";
in
{
  floe-upstream =
    pkgs.runCommand "floe-upstream"
      {
        failures = lines (
          lib.optional (unexplained != [ ]) (
            lines (
              [ "two floes pin the same upstream:" ]
              ++ map (c: "  ${inline duplicates.${c}} -> ${c}") unexplained
              ++ [
                ""
                "One upstream has one owner. If both floes really do install it,"
                "record why in `sharedPins` in nix/checks/default.nix."
              ]
            )
          )
          ++ lib.optional (resolved != [ ]) (
            lines (
              [ "listed in `sharedPins` and no longer shared:" ]
              ++ map (c: "  ${c}") resolved
              ++ [ "Drop the entry." ]
            )
          )
          ++ lib.optional (contested != { }) (
            lines (
              [ "an API group is claimed by more than one floe:" ]
              ++ lib.mapAttrsToList (g: floes: "  ${g} <- ${inline floes}") contested
              ++ [
                ""
                "A group is one key in `lib/floe-crds.nix`, so two floes generating"
                "it would be two files claiming it. Whichever floe installs the CRDs"
                "owns the group; the other should resolve against them, not restate"
                "them."
              ]
            )
          )
          ++ lib.optional (orphans != [ ]) (
            lines (
              [ "a directory carries a pin and is not a floe in the set:" ]
              ++ map (f: "  floes/components/${f}/upstream.nix") orphans
              ++ [
                ""
                "Nothing collects it and nothing regenerates what it pins. Add the"
                "floe to `floes/default.nix`, or delete the directory."
              ]
            )
          )
        );
      }
      ''
        if [ -n "$failures" ]; then
          printf '%s\n' "$failures" >&2
          exit 1
        fi

        echo "${toString (lib.length (lib.attrNames pinned))} pins, each owned by one floe" > $out
      '';
}
