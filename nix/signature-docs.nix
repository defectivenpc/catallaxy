# One page per signature.
#
# A signature is a module's interface to every other module, and the only
# documentation it had was repeated on the pages of the floes that touch it:
# `docs/generated/floes/lab-ca.md` says what `DNS_ZONE` is because `lab-ca`
# requires it, and so do nine others. What none of them could say is the thing
# a reader actually arrives wanting — *which floe answers this* — because no
# floe knows its own peers.
#
# That is computed here, off the floe set, and it is the point of the page.
# `requires.zone = sigs.DNS_ZONE` is a question; this is where the answers are
# listed.
{
  lib,
  pkgs,
  floeSet,
  catallaxy,
  cataCharts,
  k8sSpecs,
}:

let
  inherit (catallaxy) floe sigs kinds;

  defOf =
    name:
    import floeSet.${name} {
      inherit
        lib
        pkgs
        catallaxy
        cataCharts
        k8sSpecs
        floes
        ;
      inherit
        floe
        sigs
        kinds
        ;
    };

  floes = lib.mapAttrs (
    name: _:
    let
      def = defOf name;
    in
    def // { __functor = _: def.instantiate; }
  ) floeSet;

  defs = lib.mapAttrs (name: _: defOf name) floeSet;

  # ---- who touches each signature -----------------------------------------
  #
  # Keyed by the signature's `name` and not by the attribute it is declared
  # under, because a floe names its own holes: `lab-ca` calls its `DNS_ZONE`
  # hole `zone` and the declaration is `requires.zone = sigs.DNS_ZONE`. The
  # hole's name is the floe's business; the signature is what both sides agree
  # on.
  #
  # `[{ floe; hole; }]`, so the page can say both — a reader following a link
  # back wants to know what to grep for in the floe.
  touching =
    field: sigName:
    lib.concatLists (
      lib.mapAttrsToList (
        floeName: def:
        lib.mapAttrsToList (hole: _: {
          floe = floeName;
          inherit hole;
        }) (lib.filterAttrs (_: sig: sig.name == sigName) (def.${field} or { }))
      ) defs
    );

  # ---- the page, as data ---------------------------------------------------
  #
  # What the page *is*. The markdown is `cli/src/docs/page.rs`, so this file
  # never decides how a table escapes a `|` or what an empty section looks
  # like — three generators used to answer those three ways.

  table = columns: rows: { inherit columns rows; };

  # A floe, as a link to its own page. Sibling directories under
  # `docs/generated/`, so the hop is one level up and back down.
  floeLink = name: "[`${name}`](../floes/${name}.md)";

  touchSection = heading: field: sigName: {
    inherit heading;
    table = table [ "floe" "as" ] (
      map (t: [
        (floeLink t.floe)
        "`${field}.${t.hole}`"
      ]) (touching field sigName)
    );
  };

  document =
    sigName: sig:
    let
      providers = touching "provides" sigName;

      isProjection = !(sig ? behaviour);
    in
    {
      path = "signatures/${sigName}.md";
      title = sigName;

      lead = [
        sig.description
        "<!-- Generated by nix/signature-docs.nix from nix build .#referencePages -->"

        ''
          Canonically `${sig.canonicalName}`. A floe providing this must declare it
          as `provides.${sig.canonicalName}`; a hole that resolves it may be called
          anything.''
      ]

      ++ lib.optional (providers == [ ] && !isProjection) ''
        *No built-in floe provides it.* A lab's own cluster floes can — they sit
        beside the `lab.nix` that places them and are not in `floes/` — so this
        is not the same as nothing answering it.''

      ++ lib.optional isProjection ''
        A **projection**: a narrowed view of another signature, for crossing a
        boundary. Whatever provides the signature it narrows answers this, so it
        has no provider of its own.'';

      sections = [
        {
          heading = "Fields";
          table = table [ "field" "type" ] (
            lib.mapAttrsToList (f: t: [
              f
              (t.name or t.tag or "—")
            ]) sig.fields
          );
        }

        (touchSection "Provided by" "provides" sigName)
        (touchSection "Required by" "requires" sigName)
        (touchSection "Required optionally by" "optional" sigName)
        (touchSection "Collected by" "collects" sigName)
        (touchSection "Exported through" "exports" sigName)
      ];
    };

  index = {
    path = "signatures/index.md";
    title = "Signatures";

    lead = [
      ''
        What one module promises another. A floe declares the signatures it
        answers and the ones it needs; the linker resolves between them, and
        neither side names the other.''
      "<!-- Generated by nix/signature-docs.nix from nix build .#referencePages -->"
    ];

    sections = [
      {
        heading = "Every signature";
        table = table [ "signature" "canonically" "what it is" ] (
          lib.mapAttrsToList (n: sig: [
            "[${n}](./${n}.md)"
            "`${sig.canonicalName}`"
            sig.description
          ]) sigs
        );
      }
    ];
  };

  pages = [ index ] ++ lib.mapAttrsToList document sigs;
in
pkgs.runCommand "signature-pages" { } ''
  mkdir -p $out
  ${lib.concatStringsSep "\n" (
    lib.imap0 (
      i: p: "cp ${pkgs.writeText "page-${toString i}.json" (builtins.toJSON p)} $out/${toString i}.json"
    ) pages
  )}
''
