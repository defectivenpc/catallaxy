# What a reference-page generator needs beyond its own subject.
#
# A generator reads declarations and says what each page *is*, as a record
# `cata-build docs pages` turns into markdown. Three of them do that, and these
# are the parts that are the same in all three.
#
#   generators = import ./page.nix { inherit lib pkgs; };
#
#   generators.table [ "field" "type" ] [ [ "name" "`str`" ] ]
#     => { columns = [ "field" "type" ]; rows = [ [ "name" "`str`" ] ]; }
#
#   generators.touching floes "provides" "LAB_CA"
#     => [ { floe = "lab-ca"; hole = "ca"; } ]
#
#   generators.emitPages "signature-pages" pages
#     => a derivation holding one `<i>.json` per page
#
# `touching` is over any hole field — `provides`, `requires`, `optional`,
# `collects`, `exports`, or `out`, which is how a kind finds its writers.
#
# `floeLink` is relative from `signatures/` or `kinds/`; a page under `floes/`
# links its siblings directly.
{
  lib,
  pkgs,
}:

{
  table = columns: rows: { inherit columns rows; };

  floeLink = name: "[`${name}`](../floes/${name}.md)";

  banner = "<!-- Generated by nix build .#referencePages -->";

  touching =
    floes: field: sigName:
    lib.concatLists (
      lib.mapAttrsToList (
        floeName: def:
        lib.mapAttrsToList (hole: _: {
          floe = floeName;
          inherit hole;
        }) (lib.filterAttrs (_: sig: sig.name == sigName) (def.${field} or { }))
      ) floes
    );

  emitPages =
    name: pages:
    pkgs.runCommand name { } ''
      mkdir -p $out
      ${lib.concatStringsSep "\n" (
        lib.imap0 (
          i: p: "cp ${pkgs.writeText "page-${toString i}.json" (builtins.toJSON p)} $out/${toString i}.json"
        ) pages
      )}
    '';
}
